APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=epcc
DB_USERNAME=epcc
DB_PASSWORD=epcc_dev
# The project is Postgres-only (RLS boundaries, exclusion constraints,
# advisory locks); sqlite cannot run the migrations or the suite.
# Full-suite isolation: some tests spawn real worker processes and refuse
# to run unless the Postgres host is a Unix-socket directory under
# /tmp/epcc- and the test database is epcc_test (see phpunit.xml). For a
# complete green suite, run Postgres with
#   unix_socket_directories = '/var/run/postgresql,/tmp/epcc-pg'
# and set DB_HOST=/tmp/epcc-pg here.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gate-1 hardening (see config/epcc.php)
# Login attempts per minute per IP+email pair.
EPCC_LOGIN_THROTTLE_PER_MINUTE=10
# List seeded demo accounts on the unauthenticated login screen.
# Defaults to APP_DEBUG when unset; set false explicitly anywhere public.
EPCC_DEMO_LOGIN_HINTS=false
# Allow `migrate:fresh --seed` to write demo identities in production.
EPCC_ALLOW_DEMO_SEED=false
