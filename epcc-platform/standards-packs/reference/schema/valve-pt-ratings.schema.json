{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Valve pressure-temperature rating reference pack (ASME B16.34)",
 "type": "object",
 "required": [
  "refId",
  "version",
  "source",
  "units",
  "standard",
  "curves"
 ],
 "additionalProperties": false,
 "properties": {
  "refId": {
   "const": "valve-pt-ratings"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "source": {
   "type": "string",
   "minLength": 10
  },
  "note": {
   "type": "string"
  },
  "conventions": {
   "type": "object"
  },
  "units": {
   "type": "object",
   "required": [
    "pressure",
    "temperature"
   ],
   "additionalProperties": false,
   "properties": {
    "pressure": {
     "const": "kPa"
    },
    "temperature": {
     "const": "C"
    }
   }
  },
  "standard": {
   "type": "object",
   "required": [
    "code",
    "editionYear",
    "pressureClasses",
    "ratingClasses",
    "tabulatedRatingClasses",
    "materialGroupCount"
   ],
   "additionalProperties": false,
   "properties": {
    "code": {
     "const": "B16.34"
    },
    "editionYear": {
     "type": "integer",
     "minimum": 1900
    },
    "title": {
     "type": "string"
    },
    "pressureClasses": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[0-9]+$"
     }
    },
    "ratingClasses": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "enum": [
       "STANDARD",
       "SPECIAL",
       "LIMITED"
      ]
     }
    },
    "tabulatedRatingClasses": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "enum": [
       "STANDARD",
       "SPECIAL"
      ]
     }
    },
    "materialGroupCount": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "curves": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "standard",
     "editionYear",
     "materialGroup",
     "ratingClass",
     "verified",
     "sourceTable",
     "materials",
     "points"
    ],
    "additionalProperties": false,
    "properties": {
     "standard": {
      "const": "B16.34"
     },
     "editionYear": {
      "type": "integer",
      "minimum": 1900
     },
     "materialGroup": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
     },
     "ratingClass": {
      "enum": [
       "STANDARD",
       "SPECIAL"
      ]
     },
     "verified": {
      "type": "boolean"
     },
     "sourceTable": {
      "type": "string",
      "minLength": 5
     },
     "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "spec",
        "grade",
        "noteRefs"
       ],
       "additionalProperties": false,
       "properties": {
        "spec": {
         "type": "string",
         "pattern": "^[AB][0-9]{3}$"
        },
        "grade": {
         "type": [
          "string",
          "null"
         ],
         "minLength": 1
        },
        "noteRefs": {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 1
         }
        }
       }
      }
     },
     "notes": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "ref",
        "text"
       ],
       "additionalProperties": false,
       "properties": {
        "ref": {
         "type": "integer",
         "minimum": 1
        },
        "text": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     },
     "points": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "required": [
        "temperatureC",
        "byClass"
       ],
       "additionalProperties": false,
       "properties": {
        "temperatureC": {
         "type": "integer"
        },
        "byClass": {
         "type": "object",
         "minProperties": 1,
         "additionalProperties": {
          "type": "integer",
          "minimum": 0
         },
         "propertyNames": {
          "pattern": "^[0-9]+$"
         }
        }
       }
      }
     }
    }
   }
  },
  "observations": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "anomalies": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "kind",
     "materialGroup",
     "ratingClass",
     "temperatureC",
     "pressureClass",
     "printedKpa",
     "doNotCite",
     "evidence"
    ],
    "additionalProperties": false,
    "properties": {
     "kind": {
      "enum": [
       "SUSPECTED_PRINTING_ERROR"
      ]
     },
     "materialGroup": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
     },
     "ratingClass": {
      "enum": [
       "STANDARD",
       "SPECIAL"
      ]
     },
     "temperatureC": {
      "type": "integer"
     },
     "pressureClass": {
      "type": "string",
      "pattern": "^[0-9]+$"
     },
     "printedKpa": {
      "type": "integer",
      "minimum": 0
     },
     "corroboratedKpa": {
      "type": "integer",
      "minimum": 0
     },
     "doNotCite": {
      "type": "boolean"
     },
     "evidence": {
      "type": "string",
      "minLength": 40
     }
    }
   }
  },
  "corroboration": {
   "type": "object"
  },
  "crossStandardDiscrepancies": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "materialGroup",
     "temperatureC",
     "pressureClass",
     "b1634StandardClassKpa",
     "b165Kpa",
     "deltaKpa"
    ],
    "additionalProperties": false,
    "properties": {
     "materialGroup": {
      "type": "string"
     },
     "temperatureC": {
      "type": "integer"
     },
     "pressureClass": {
      "type": "string"
     },
     "b1634StandardClassKpa": {
      "type": "integer"
     },
     "b165Kpa": {
      "type": "integer"
     },
     "deltaKpa": {
      "type": "integer"
     }
    }
   }
  },
  "seatRatingRule": {
   "type": "object"
  },
  "seatRatings": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "valveType",
     "seatMaterial",
     "discriminators",
     "dnAboveExclusive",
     "dnUpToInclusive",
     "pressureClass",
     "points",
     "verified",
     "source",
     "readOn"
    ],
    "additionalProperties": false,
    "properties": {
     "valveType": {
      "enum": [
       "BALL",
       "BUTTERFLY"
      ]
     },
     "seatMaterial": {
      "enum": [
       "PTFE",
       "RPTFE"
      ]
     },
     "discriminators": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "dnAboveExclusive": {
      "type": [
       "integer",
       "null"
      ]
     },
     "dnUpToInclusive": {
      "type": [
       "integer",
       "null"
      ]
     },
     "pressureClass": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^[0-9]+$"
     },
     "verified": {
      "type": "boolean"
     },
     "source": {
      "type": "string"
     },
     "readOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "points": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "required": [
        "temperatureC",
        "barG"
       ],
       "additionalProperties": false,
       "properties": {
        "temperatureC": {
         "type": "integer"
        },
        "barG": {
         "type": "number",
         "minimum": 0
        }
       }
      }
     }
    }
   }
  }
 }
}
