    {
      "code": "NOZZLE",
      "name": {
        "en": "Equipment nozzle",
        "fa": "نازل تجهیز"
      },
      "category": "EQUIPMENT",
      "sizeRule": "SAME_AS_FIRST",
      "ownerKind": "NOZZLE",
      "isTagged": true,
