    { "code": "PERMIT", "name": { "en": "Work Permit", "fa": "مجوز کار" }, "severity": "hard", "defaultOwnerRole": "hseManager", "autoCheck": { "source": "hse.permit", "clearWhenEvent": "permit.issued.v1" }, "waiverAllowed": false },
