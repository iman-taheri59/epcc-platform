  "complianceChecklist": [
    { "id": "IPS-01", "standardRef": "IPS General", "requirement": { "en": "Every engineering deliverable references the applicable IPS standard.", "fa": "هر مدرک مهندسی به استاندارد IPS مربوطه ارجاع دارد." }, "evidence": { "objectType": "deliverable", "condition": "ips_reference != null" }, "severity": "mandatory" },
    { "id": "GCC-01", "standardRef": "نشریه ۴۳۱۱ ماده ۳۷", "requirement": { "en": "Interim payment certificates are verified by the consulting engineer before employer approval.", "fa": "صورت‌وضعیت‌های موقت پیش از تصویب کارفرما توسط مهندس مشاور تأیید می‌شوند." }, "evidence": { "objectType": "interimPaymentCertificate", "condition": "state >= 'EMPLOYER_APPROVED' implies consultantVerified == true" }, "severity": "mandatory" },
    { "id": "GCC-02", "standardRef": "نشریه ۴۳۱۱ ماده ۳۵", "requirement": { "en": "Retention is withheld from every interim payment at the contractual rate.", "fa": "حسن انجام کار طبق نرخ قراردادی از هر پرداخت موقت کسر می‌شود." }, "evidence": { "objectType": "interimPaymentCertificate", "condition": "retentionApplied == true" }, "severity": "mandatory" },
    { "id": "GCC-03", "standardRef": "نشریه ۴۳۱۱ ماده ۳۶", "requirement": { "en": "Advance payment is recovered progressively against interim certificates.", "fa": "پیش‌پرداخت به تدریج از صورت‌وضعیت‌های موقت بازپرداخت می‌شود." }, "evidence": { "objectType": "interimPaymentCertificate", "condition": "advanceRecoveryApplied == true" }, "severity": "mandatory" },
    { "id": "GCC-04", "standardRef": "نشریه ۴۳۱۱ ماده ۳۹", "requirement": { "en": "Provisional acceptance is granted only after essential defects are rectified.", "fa": "تحویل موقت تنها پس از رفع نواقص اساسی صادر می‌شود." }, "evidence": { "objectType": "certificate", "condition": "type == 'provisional' implies openCategoryAPunch == 0" }, "severity": "mandatory" },
    { "id": "GCC-05", "standardRef": "نشریه ۴۳۱۱ ماده ۴۲", "requirement": { "en": "Final acceptance follows the elapsed warranty period with all defects closed.", "fa": "تحویل قطعی پس از سپری شدن دوره تضمین و رفع همه نواقص انجام می‌شود." }, "evidence": { "objectType": "certificate", "condition": "type == 'final' implies warrantyElapsed and openDefects == 0" }, "severity": "mandatory" },
    { "id": "GCC-06", "standardRef": "نشریه ۴۳۱۱", "requirement": { "en": "Site minutes are signed by employer, consultant and contractor representatives.", "fa": "صورتجلسه‌های کارگاهی به امضای نمایندگان کارفرما، مشاور و پیمانکار می‌رسد." }, "evidence": { "objectType": "siteMinutes", "condition": "signatureCount >= 3" }, "severity": "mandatory" },
    { "id": "TADIL-01", "standardRef": "دستورالعمل تعدیل", "requirement": { "en": "Price adjustment is computed per period using the published index coefficients.", "fa": "تعدیل در هر دوره با استفاده از شاخص‌های ابلاغی محاسبه می‌شود." }, "evidence": { "objectType": "priceAdjustment", "condition": "indexCoefficientApplied == true" }, "severity": "mandatory" },
    { "id": "HSEMS-01", "standardRef": "HSE-MS", "requirement": { "en": "Work permits are issued for all high-risk activities per HSE-MS.", "fa": "مجوز کار برای همه فعالیت‌های پرخطر طبق HSE-MS صادر می‌شود." }, "evidence": { "objectType": "permit", "condition": "coversAllHighRiskActivities" }, "severity": "mandatory" },
    { "id": "HSEMS-02", "standardRef": "HSE-MS", "requirement": { "en": "Monthly HSE performance report submitted to the employer.", "fa": "گزارش عملکرد ماهانه HSE به کارفرما ارائه می‌شود." }, "evidence": { "objectType": "hseReport", "minimumCount": 1 }, "severity": "mandatory" },
    { "id": "NEZAM-01", "standardRef": "نظام فنی و اجرایی کشور", "requirement": { "en": "Stage approvals are recorded by the employer before phase transition.", "fa": "تصویب مرحله‌ای پیش از گذار فاز توسط کارفرما ثبت می‌شود." }, "evidence": { "objectType": "gate", "condition": "approvedBy.companyType == 'OWN'" }, "severity": "mandatory" }
  ],

