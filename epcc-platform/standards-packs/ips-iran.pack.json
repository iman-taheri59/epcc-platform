        { "check": "progressVerifiedByConsultant", "message": { "en": "Physical progress must be verified by the consulting engineer.", "fa": "پیشرفت فیزیکی باید توسط مهندس مشاور تأیید شود." } },
        { "check": "deductionsCalculated", "message": { "en": "Retention, advance recovery, price adjustment and tax must all be computed.", "fa": "حسن انجام کار، بازپرداخت پیش‌پرداخت، تعدیل و مالیات باید محاسبه شوند." } },
        { "check": "budgetWithinAuthority", "message": { "en": "Amount exceeds the approver's delegated authority.", "fa": "مبلغ از حدود اختیارات تأییدکننده فراتر است." } }
