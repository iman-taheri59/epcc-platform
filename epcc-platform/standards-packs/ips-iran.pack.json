  "kpis": [
    { "code": "PHYS_PROGRESS", "name": { "en": "Physical Progress vs Plan", "fa": "پیشرفت فیزیکی در برابر برنامه" }, "definition": { "en": "Weighted actual physical progress against the approved baseline.", "fa": "پیشرفت فیزیکی وزنی واقعی در برابر برنامه مبنای مصوب." }, "formula": "sum(actualWeightedProgress) / sum(plannedWeightedProgress) * 100", "unit": "%", "target": 100, "direction": "higherIsBetter", "thresholds": { "green": 95, "amber": 85, "red": 75 }, "ownerRole": "planner", "dashboards": ["executive", "pm"] },
    { "code": "SV_CYCLE", "name": { "en": "Payment Certificate Cycle Time", "fa": "زمان چرخه صورت‌وضعیت" }, "definition": { "en": "Calendar days from contractor submission to employer approval.", "fa": "روزهای تقویمی از ارسال پیمانکار تا تصویب کارفرما." }, "formula": "avg(days(approved_at - submitted_at))", "unit": "days", "target": 30, "direction": "lowerIsBetter", "thresholds": { "green": 30, "amber": 45, "red": 60 }, "ownerRole": "costController", "dashboards": ["executive", "commercial"] },
    { "code": "SV_DEDUCTION_RATE", "name": { "en": "Payment Certificate Deduction Rate", "fa": "نرخ کسورات صورت‌وضعیت" }, "definition": { "en": "Share of claimed value deducted by consultant or employer.", "fa": "سهم مبلغ درخواستی که توسط مشاور یا کارفرما کسر شده است." }, "formula": "sum(claimedAmount - approvedAmount) / sum(claimedAmount) * 100", "unit": "%", "target": 3, "direction": "lowerIsBetter", "thresholds": { "green": 3, "amber": 8, "red": 15 }, "ownerRole": "costController", "dashboards": ["commercial"] },
    { "code": "RECEIVABLE_AGE", "name": { "en": "Receivable Aging", "fa": "سن مطالبات" }, "definition": { "en": "Average days approved payment certificates remain unpaid.", "fa": "میانگین روزهایی که صورت‌وضعیت‌های مصوب پرداخت نشده باقی می‌مانند." }, "formula": "avg(days(now - approved_at)) where state == 'EMPLOYER_APPROVED'", "unit": "days", "target": 45, "direction": "lowerIsBetter", "thresholds": { "green": 45, "amber": 90, "red": 150 }, "ownerRole": "financeManager", "dashboards": ["executive", "commercial"] },
    { "code": "TADIL_EXPOSURE", "name": { "en": "Unclaimed Price Adjustment", "fa": "تعدیل مطالبه‌نشده" }, "definition": { "en": "Value of price adjustment earned but not yet submitted.", "fa": "ارزش تعدیل تحقق‌یافته که هنوز مطالبه نشده است." }, "formula": "sum(earnedAdjustment) - sum(submittedAdjustment)", "unit": "currency", "direction": "lowerIsBetter", "ownerRole": "costController", "dashboards": ["commercial"] },
    { "code": "DOC_CODE1_RATE", "name": { "en": "First-Pass Code 1 Rate", "fa": "نرخ دریافت کد ۱ در نوبت اول" }, "definition": { "en": "Documents reaching code 1 without a code 3 rejection.", "fa": "مدارکی که بدون دریافت کد ۳ به کد ۱ رسیده‌اند." }, "formula": "count(deliverable where code3Count == 0 and state >= 'CODE1') / count(deliverable at CODE1) * 100", "unit": "%", "target": 65, "direction": "higherIsBetter", "thresholds": { "green": 65, "amber": 50, "red": 35 }, "ownerRole": "engineeringManager", "dashboards": ["engineering"] },
    { "code": "DOC_TAT", "name": { "en": "Consultant Review Turnaround", "fa": "زمان بررسی مشاور" }, "formula": "avg(days(reviewed_at - submitted_at))", "unit": "days", "target": 14, "direction": "lowerIsBetter", "thresholds": { "green": 14, "amber": 21, "red": 30 }, "ownerRole": "documentController", "dashboards": ["engineering", "pm"] },
    { "code": "PUNCH_TAHVIL", "name": { "en": "Defects Blocking Provisional Acceptance", "fa": "نواقص مانع تحویل موقت" }, "formula": "count(punchItem where category == 'A' and state not in terminal)", "unit": "count", "target": 0, "direction": "lowerIsBetter", "thresholds": { "green": 0, "amber": 5, "red": 15 }, "ownerRole": "constructionManager", "dashboards": ["executive", "commissioning"] },
    { "code": "HSE_MS_COMPLIANCE", "name": { "en": "HSE-MS Compliance Score", "fa": "امتیاز انطباق HSE-MS" }, "formula": "count(hseRequirement where satisfied) / count(hseRequirement) * 100", "unit": "%", "target": 95, "direction": "higherIsBetter", "thresholds": { "green": 95, "amber": 85, "red": 70 }, "ownerRole": "hseManager", "dashboards": ["executive", "hse"] },
    { "code": "SPI", "name": { "en": "Schedule Performance Index", "fa": "شاخص عملکرد زمانی" }, "formula": "sum(BCWP) / sum(BCWS)", "unit": "ratio", "target": 1.0, "direction": "higherIsBetter", "thresholds": { "green": 0.95, "amber": 0.9, "red": 0.85 }, "ownerRole": "planner", "dashboards": ["executive", "pm"] },
    { "code": "CPI", "name": { "en": "Cost Performance Index", "fa": "شاخص عملکرد هزینه" }, "formula": "sum(BCWP) / sum(ACWP)", "unit": "ratio", "target": 1.0, "direction": "higherIsBetter", "thresholds": { "green": 0.98, "amber": 0.93, "red": 0.88 }, "ownerRole": "costController", "dashboards": ["executive", "pm"] }
  ],

