        { "check": "asBuiltSubmitted", "message": { "en": "As-built documentation must be submitted and accepted.", "fa": "مدارک چون‌ساخت باید ارائه و پذیرفته شود." } },
        { "check": "allItrsSigned", "params": { "itrTypes": ["A", "B"] }, "message": { "en": "All A and B inspection records must be signed.", "fa": "همه گزارش‌های بازرسی نوع الف و ب باید امضا شده باشند." } }
      ],
