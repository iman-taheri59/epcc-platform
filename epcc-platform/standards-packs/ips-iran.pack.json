    { "code": "SITE", "name": { "en": "Site Access / Land Handover", "fa": "دسترسی به کارگاه / تحویل زمین" }, "severity": "hard", "defaultOwnerRole": "projectManager", "waiverAllowed": true, "waiverApproverCapability": "project.waiver.approve" }
