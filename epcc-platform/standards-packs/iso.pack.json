{
  "packId": "iso",
  "version": "1.0.0",
  "kind": "iso",
  "name": {
    "en": "ISO Framework Pack",
    "fa": "بسته چارچوب ایزو"
  },
  "description": {
    "en": "Project governance based on ISO 21500/21502 with ISO 19650 information management, ISO 9001 quality, ISO 31000 risk and ISO 15926/CFIHOS handover data.",
    "fa": "راهبری پروژه بر پایه ایزو ۲۱۵۰۰/۲۱۵۰۲ همراه با مدیریت اطلاعات ایزو ۱۹۶۵۰، کیفیت ایزو ۹۰۰۱، ریسک ایزو ۳۱۰۰۰ و داده تحویل ایزو ۱۵۹۲۶."
  },
  "standardsReferences": [
    { "code": "ISO 21502:2020", "title": { "en": "Project management guidance", "fa": "راهنمای مدیریت پروژه" }, "scope": "Governance, gates, PM plan" },
    { "code": "ISO 19650-2:2018", "title": { "en": "Information management - delivery phase", "fa": "مدیریت اطلاعات - فاز تحویل" }, "scope": "CDE states, suitability codes, naming" },
    { "code": "ISO 9001:2015", "title": { "en": "Quality management systems", "fa": "سیستم مدیریت کیفیت" }, "scope": "ITP, NCR, CAPA, audit" },
    { "code": "ISO 31000:2018", "title": { "en": "Risk management", "fa": "مدیریت ریسک" }, "scope": "Risk register and response" },
    { "code": "ISO 15926 / CFIHOS 1.5", "title": { "en": "Plant lifecycle data", "fa": "داده چرخه عمر واحد صنعتی" }, "scope": "Tag class library, handover" },
    { "code": "ISO 45001:2018", "title": { "en": "Occupational health and safety", "fa": "ایمنی و بهداشت شغلی" }, "scope": "Permit, incident, competence" }
  ],

  "terminology": {
    "workPackage": { "en": "Work Package", "fa": "بسته کاری" },
    "deliverable": { "en": "Deliverable", "fa": "قلم تحویلی" },
    "deliverableRegister": { "en": "Master Deliverable Register (MDR)", "fa": "فهرست اصلی مدارک" },
    "informationContainer": { "en": "Information Container", "fa": "ظرف اطلاعاتی" },
    "breakdownPrimary": { "en": "Work Breakdown Structure", "fa": "ساختار شکست کار" },
    "areaUnit": { "en": "Plant Area / Unit", "fa": "ناحیه / واحد" },
    "gate": { "en": "Stage Gate Review", "fa": "بازنگری دروازه مرحله‌ای" },
    "progressBasis": { "en": "Physical Progress", "fa": "پیشرفت فیزیکی" }
  },

  "breakdownStructures": [
    { "code": "WBS", "name": { "en": "Work Breakdown Structure", "fa": "ساختار شکست کار" }, "enabled": true, "mandatory": true, "maxDepth": 8, "parentOf": ["ACTIVITY"], "codingRule": "num.wbs" },
    { "code": "CBS", "name": { "en": "Cost Breakdown Structure", "fa": "ساختار شکست هزینه" }, "enabled": true, "mandatory": true, "maxDepth": 6 },
    { "code": "OBS", "name": { "en": "Organizational Breakdown Structure", "fa": "ساختار شکست سازمانی" }, "enabled": true, "maxDepth": 5 },
    { "code": "PBS", "name": { "en": "Product Breakdown Structure", "fa": "ساختار شکست محصول" }, "enabled": true, "maxDepth": 6 },
    { "code": "SBS", "name": { "en": "System Breakdown Structure", "fa": "ساختار شکست سیستم" }, "enabled": true, "mandatory": true, "maxDepth": 3, "parentOf": ["TAG"] },
    { "code": "AREA", "name": { "en": "Plant / Area / Unit", "fa": "واحد / ناحیه" }, "enabled": true, "maxDepth": 4 },
    { "code": "CWA", "name": { "en": "Construction Work Area", "fa": "محدوده کاری اجرا" }, "enabled": false },
    { "code": "CWP", "name": { "en": "Construction Work Package", "fa": "بسته کاری اجرا" }, "enabled": false },
    { "code": "EWP", "name": { "en": "Engineering Work Package", "fa": "بسته کاری مهندسی" }, "enabled": false },
    { "code": "PWP", "name": { "en": "Procurement Work Package", "fa": "بسته کاری تأمین" }, "enabled": false },
    { "code": "IWP", "name": { "en": "Installation Work Package", "fa": "بسته کاری نصب" }, "enabled": false },
    { "code": "TWP", "name": { "en": "Turnover Work Package", "fa": "بسته کاری تحویل" }, "enabled": true, "maxDepth": 2 }
  ],

  "objectTypes": [
    {
      "type": "deliverable",
      "enabled": true,
      "lifecycle": "lc.iso19650.document",
      "numbering": "num.iso19650.doc",
      "requiredAttributes": [
        { "field": "discipline_code", "requiredFromState": "WIP", "message": { "en": "Discipline is mandatory.", "fa": "دیسیپلین الزامی است." } },
        { "field": "suitability", "requiredFromState": "SHARED", "message": { "en": "Suitability code required before sharing.", "fa": "کد تناسب پیش از اشتراک‌گذاری الزامی است." } },
        { "field": "reviewer_company_id", "requiredFromState": "SHARED", "message": { "en": "Assign a reviewing company.", "fa": "شرکت بازنگر را تعیین کنید." } },
        { "field": "system_id", "requiredFromState": "PUBLISHED", "message": { "en": "Link to a system before publishing.", "fa": "پیش از انتشار به یک سیستم متصل کنید." } }
      ]
    },
    { "type": "tag", "enabled": true, "numbering": "num.tag" },
    { "type": "ncr", "enabled": true, "lifecycle": "lc.ncr", "numbering": "num.ncr" },
    { "type": "risk", "enabled": true, "numbering": "num.risk" },
    { "type": "tq", "enabled": true, "numbering": "num.tq" },
    { "type": "punchItem", "enabled": true, "lifecycle": "lc.punch" },
    { "type": "certificate", "enabled": true },
    { "type": "iwp", "enabled": false }
  ],

  "lifecycles": [
    {
      "id": "lc.iso19650.document",
      "appliesTo": ["deliverable", "vendorDocument"],
      "states": [
        { "code": "WIP", "name": { "en": "Work in Progress", "fa": "در حال انجام" }, "category": "draft", "suitabilityCode": "S0", "colour": "#94A3B8" },
        { "code": "SHARED_IFR", "name": { "en": "Shared - Issued for Review", "fa": "اشتراکی - صادر برای بازنگری" }, "category": "inReview", "suitabilityCode": "S1", "colour": "#F59E0B" },
        { "code": "SHARED_IFA", "name": { "en": "Shared - Issued for Approval", "fa": "اشتراکی - صادر برای تأیید" }, "category": "inReview", "suitabilityCode": "S3", "colour": "#F97316" },
        { "code": "APPROVED", "name": { "en": "Approved (A1)", "fa": "تأیید شده" }, "category": "approved", "suitabilityCode": "A1", "colour": "#22C55E" },
        { "code": "PUBLISHED_IFC", "name": { "en": "Published - Issued for Construction", "fa": "منتشر شده - صادر برای اجرا" }, "category": "issued", "suitabilityCode": "A1", "colour": "#16A34A" },
        { "code": "AS_BUILT", "name": { "en": "As-Built", "fa": "چون‌ساخت" }, "category": "closed", "suitabilityCode": "A5", "colour": "#0EA5E9" },
        { "code": "ARCHIVED", "name": { "en": "Archived", "fa": "بایگانی شده" }, "category": "closed", "colour": "#64748B", "isTerminal": true },
        { "code": "SUPERSEDED", "name": { "en": "Superseded", "fa": "منسوخ شده" }, "category": "cancelled", "colour": "#EF4444", "isTerminal": true }
      ],
      "transitions": [
        { "from": "WIP", "to": "SHARED_IFR", "capability": "document.share", "allowedCompanyTypes": ["EPC", "SUB", "VEN"], "guards": [{ "check": "interDisciplineCheckComplete", "message": { "en": "Inter-discipline check (IDC) must be signed off.", "fa": "کنترل بین‌دیسیپلینی باید تأیید شده باشد." } }], "slaHours": 24, "emitsEvent": "document.shared.v1" },
        { "from": "SHARED_IFR", "to": "WIP", "capability": "document.recall", "allowedCompanyTypes": ["EPC", "SUB", "VEN"] },
        { "from": "SHARED_IFR", "to": "SHARED_IFA", "capability": "document.submit.approval", "allowedCompanyTypes": ["EPC"], "guards": [{ "check": "reviewCommentsDispositioned", "message": { "en": "All review comments must be dispositioned.", "fa": "همه نظرات بازنگری باید تعیین‌تکلیف شوند." } }], "slaHours": 240 },
        { "from": "SHARED_IFA", "to": "APPROVED", "capability": "document.approve", "allowedCompanyTypes": ["OWN", "PMC"], "slaHours": 336, "escalateAfterHours": 240, "signatureRequired": "advanced", "emitsEvent": "document.approved.v1" },
        { "from": "SHARED_IFA", "to": "WIP", "capability": "document.reject", "allowedCompanyTypes": ["OWN", "PMC"], "emitsEvent": "document.rejected.v1" },
        { "from": "APPROVED", "to": "PUBLISHED_IFC", "capability": "document.publish", "allowedCompanyTypes": ["EPC"], "signatureRequired": "advanced", "emitsEvent": "document.published.v1" },
        { "from": "PUBLISHED_IFC", "to": "AS_BUILT", "capability": "document.asbuilt", "allowedCompanyTypes": ["EPC"], "guards": [{ "check": "redlinesConsolidated", "message": { "en": "Field red-lines must be consolidated.", "fa": "اصلاحات کارگاهی باید تجمیع شوند." } }] },
        { "from": "PUBLISHED_IFC", "to": "SUPERSEDED", "capability": "document.supersede", "allowedCompanyTypes": ["EPC"] },
        { "from": "AS_BUILT", "to": "ARCHIVED", "capability": "document.archive", "allowedCompanyTypes": ["OWN", "EPC"] }
      ]
    },
    {
      "id": "lc.ncr",
      "appliesTo": ["ncr"],
      "states": [
        { "code": "RAISED", "name": { "en": "Raised", "fa": "صادر شده" }, "category": "draft", "colour": "#EF4444" },
        { "code": "ACKNOWLEDGED", "name": { "en": "Acknowledged", "fa": "دریافت تأیید شد" }, "category": "inReview", "colour": "#F59E0B" },
        { "code": "DISPOSITION", "name": { "en": "Disposition Proposed", "fa": "تعیین تکلیف پیشنهادی" }, "category": "inReview", "colour": "#F97316" },
        { "code": "DISPOSITION_APPROVED", "name": { "en": "Disposition Approved", "fa": "تعیین تکلیف تأیید شد" }, "category": "approved", "colour": "#84CC16" },
        { "code": "ACTION_COMPLETE", "name": { "en": "Corrective Action Complete", "fa": "اقدام اصلاحی انجام شد" }, "category": "approved", "colour": "#22C55E" },
        { "code": "VERIFIED_CLOSED", "name": { "en": "Verified and Closed", "fa": "راستی‌آزمایی و بسته شد" }, "category": "closed", "colour": "#16A34A", "isTerminal": true },
        { "code": "VOID", "name": { "en": "Void", "fa": "ابطال شده" }, "category": "cancelled", "colour": "#64748B", "isTerminal": true }
      ],
      "transitions": [
        { "from": "RAISED", "to": "ACKNOWLEDGED", "capability": "ncr.acknowledge", "allowedCompanyTypes": ["EPC", "SUB", "VEN"], "slaHours": 48, "escalateAfterHours": 72 },
        { "from": "ACKNOWLEDGED", "to": "DISPOSITION", "capability": "ncr.disposition.propose", "allowedCompanyTypes": ["EPC", "SUB", "VEN"], "guards": [{ "check": "rootCauseRecorded", "message": { "en": "Root cause analysis is required.", "fa": "تحلیل ریشه‌ای الزامی است." } }], "slaHours": 120 },
        { "from": "DISPOSITION", "to": "DISPOSITION_APPROVED", "capability": "ncr.disposition.approve", "allowedCompanyTypes": ["PMC", "OWN", "TPI"], "signatureRequired": "advanced" },
        { "from": "DISPOSITION_APPROVED", "to": "ACTION_COMPLETE", "capability": "ncr.action.complete", "allowedCompanyTypes": ["EPC", "SUB", "VEN"] },
        { "from": "ACTION_COMPLETE", "to": "VERIFIED_CLOSED", "capability": "ncr.verify", "allowedCompanyTypes": ["PMC", "OWN", "TPI"], "signatureRequired": "advanced", "emitsEvent": "ncr.closed.v1" },
        { "from": "RAISED", "to": "VOID", "capability": "ncr.void", "allowedCompanyTypes": ["PMC", "OWN"] }
      ]
    },
    {
      "id": "lc.punch",
      "appliesTo": ["punchItem"],
      "states": [
        { "code": "OPEN", "name": { "en": "Open", "fa": "باز" }, "category": "draft", "colour": "#EF4444" },
        { "code": "IN_PROGRESS", "name": { "en": "In Progress", "fa": "در حال رفع" }, "category": "inReview", "colour": "#F59E0B" },
        { "code": "READY_FOR_CHECK", "name": { "en": "Ready for Verification", "fa": "آماده راستی‌آزمایی" }, "category": "inReview", "colour": "#3B82F6" },
        { "code": "CLOSED", "name": { "en": "Closed", "fa": "بسته شده" }, "category": "closed", "colour": "#22C55E", "isTerminal": true },
        { "code": "REJECTED", "name": { "en": "Rejected - Reopened", "fa": "رد شده - بازگشایی" }, "category": "draft", "colour": "#DC2626" }
      ],
      "transitions": [
        { "from": "OPEN", "to": "IN_PROGRESS", "capability": "punch.assign", "allowedCompanyTypes": ["EPC", "SUB"] },
        { "from": "IN_PROGRESS", "to": "READY_FOR_CHECK", "capability": "punch.submit", "allowedCompanyTypes": ["EPC", "SUB"], "guards": [{ "check": "evidencePhotoAttached", "message": { "en": "Attach evidence photo before submitting.", "fa": "پیش از ارسال، عکس مستند پیوست کنید." } }] },
        { "from": "READY_FOR_CHECK", "to": "CLOSED", "capability": "punch.close", "allowedCompanyTypes": ["OWN", "PMC", "MC", "TPI"], "signatureRequired": "simple", "emitsEvent": "punch.closed.v1" },
        { "from": "READY_FOR_CHECK", "to": "REJECTED", "capability": "punch.reject", "allowedCompanyTypes": ["OWN", "PMC", "MC", "TPI"] },
        { "from": "REJECTED", "to": "IN_PROGRESS", "capability": "punch.assign", "allowedCompanyTypes": ["EPC", "SUB"] }
      ]
    }
  ],

  "gates": [
    {
      "code": "G1",
      "name": { "en": "Gate 1 - Project Setup Approved", "fa": "دروازه ۱ - تأیید راه‌اندازی پروژه" },
      "phase": "initiation",
      "approverCompanyType": "OWN",
      "exitCriteria": [
        { "id": "G1-01", "text": { "en": "Project management plan approved", "fa": "برنامه مدیریت پروژه تأیید شده" }, "evidenceObjectType": "deliverable", "automatable": true },
        { "id": "G1-02", "text": { "en": "WBS, CBS and OBS baselined", "fa": "ساختارهای شکست کار، هزینه و سازمان مبنا شده" }, "automatable": true },
        { "id": "G1-03", "text": { "en": "Risk register initiated with top 10 risks", "fa": "ثبت ریسک با ۱۰ ریسک اصلی آغاز شده" }, "evidenceObjectType": "risk", "automatable": true, "guard": { "check": "minimumRecordCount", "params": { "objectType": "risk", "count": 10 } } },
        { "id": "G1-04", "text": { "en": "Interface register established with all parties", "fa": "ثبت واسط‌ها با همه طرف‌ها ایجاد شده" } }
      ]
    },
    {
      "code": "G2",
      "name": { "en": "Gate 2 - Design Basis Frozen", "fa": "دروازه ۲ - انجماد مبانی طراحی" },
      "phase": "engineering",
      "approverCompanyType": "OWN",
      "exitCriteria": [
        { "id": "G2-01", "text": { "en": "All P&IDs at IFD or better", "fa": "همه نقشه‌های P&ID در وضعیت IFD یا بالاتر" }, "automatable": true, "guard": { "check": "linkedDrawingsAtStatus:IFD", "params": { "documentType": "PID" } } },
        { "id": "G2-02", "text": { "en": "HAZOP closed with all actions dispositioned", "fa": "هزاپ بسته شده و همه اقدامات تعیین تکلیف شده" } },
        { "id": "G2-03", "text": { "en": "Tag register populated for all main equipment", "fa": "ثبت تگ برای همه تجهیزات اصلی تکمیل شده" }, "evidenceObjectType": "tag", "automatable": true }
      ]
    },
    {
      "code": "G3",
      "name": { "en": "Gate 3 - Ready for Construction", "fa": "دروازه ۳ - آمادگی اجرا" },
      "phase": "construction",
      "approverCompanyType": "OWN",
      "exitCriteria": [
        { "id": "G3-01", "text": { "en": "IFC drawings issued for the first construction area", "fa": "نقشه‌های IFC برای اولین ناحیه اجرایی صادر شده" }, "automatable": true },
        { "id": "G3-02", "text": { "en": "HSE plan and permit system operational", "fa": "برنامه ایمنی و سامانه مجوز کار عملیاتی است" } },
        { "id": "G3-03", "text": { "en": "ITPs approved for all construction disciplines", "fa": "برنامه‌های بازرسی و آزمون همه دیسیپلین‌های اجرا تأیید شده" }, "evidenceObjectType": "itp", "automatable": true }
      ]
    },
    {
      "code": "G4",
      "name": { "en": "Gate 4 - Ready for Start-Up", "fa": "دروازه ۴ - آمادگی راه‌اندازی" },
      "phase": "commissioning",
      "approverCompanyType": "OWN",
      "exitCriteria": [
        { "id": "G4-01", "text": { "en": "Mechanical completion certificates issued for all subsystems", "fa": "گواهی تکمیل مکانیکی برای همه زیرسیستم‌ها صادر شده" }, "automatable": true },
        { "id": "G4-02", "text": { "en": "No open category A punch items", "fa": "هیچ نقص دسته الف بازی وجود ندارد" }, "automatable": true, "guard": { "check": "noOpenPunchOfCategory:A" } },
        { "id": "G4-03", "text": { "en": "Turnover dossier accepted by owner", "fa": "داشیه تحویل توسط کارفرما پذیرفته شده" } }
      ]
    }
  ],

  "constraintTypes": [
    { "code": "ENG", "name": { "en": "Engineering Deliverable", "fa": "قلم تحویلی مهندسی" }, "severity": "hard", "defaultOwnerRole": "disciplineLead", "autoCheck": { "source": "engineering.deliverable", "clearWhenEvent": "document.published.v1", "condition": "status == 'PUBLISHED_IFC'" }, "waiverAllowed": true, "waiverApproverCapability": "project.waiver.approve" },
    { "code": "MAT", "name": { "en": "Material Availability", "fa": "موجودی مصالح" }, "severity": "hard", "defaultOwnerRole": "materialsManager", "autoCheck": { "source": "procurement.material", "clearWhenEvent": "material.reserved.v1", "condition": "availabilityPercent >= 100" }, "waiverAllowed": true, "waiverApproverCapability": "project.waiver.approve" },
    { "code": "PERMIT", "name": { "en": "Permit / Approval", "fa": "مجوز" }, "severity": "hard", "defaultOwnerRole": "hseManager", "autoCheck": { "source": "hse.permit", "clearWhenEvent": "permit.issued.v1" }, "waiverAllowed": false },
    { "code": "QC", "name": { "en": "Quality Hold Point", "fa": "نقطه توقف کیفی" }, "severity": "hard", "defaultOwnerRole": "qcManager", "waiverAllowed": false },
    { "code": "ACCESS", "name": { "en": "Work Front Access", "fa": "دسترسی جبهه کاری" }, "severity": "soft", "defaultOwnerRole": "constructionManager", "waiverAllowed": true }
  ],

  "releaseGates": [
    {
      "objectType": "certificate.mechanicalCompletion",
      "hardBlock": true,
      "rules": [
        { "check": "noOpenPunchOfCategory:A", "message": { "en": "All category A punch items must be closed before mechanical completion.", "fa": "همه نقص‌های دسته الف باید پیش از تکمیل مکانیکی بسته شوند." } },
        { "check": "allItrsSigned", "params": { "itrTypes": ["A", "B"] }, "message": { "en": "All A and B inspection test records must be signed.", "fa": "همه گزارش‌های بازرسی نوع الف و ب باید امضا شده باشند." } },
        { "check": "allNcrsClosedForSystem", "message": { "en": "Open NCRs exist on this subsystem.", "fa": "بر روی این زیرسیستم عدم انطباق باز وجود دارد." } }
      ],
      "waiver": { "allowed": true, "approverCapability": "certificate.exception.approve", "justificationRequired": true }
    },
    {
      "objectType": "invoice",
      "hardBlock": true,
      "rules": [
        { "check": "progressVerifiedByConsultant", "message": { "en": "Progress must be verified by the consultant before invoicing.", "fa": "پیشرفت باید پیش از صورت‌وضعیت توسط مشاور تأیید شود." } },
        { "check": "budgetWithinAuthority", "message": { "en": "Amount exceeds the delegated authority for this approver.", "fa": "مبلغ از حدود اختیارات این تأییدکننده فراتر است." } }
      ],
      "waiver": { "allowed": false }
    }
  ],

  "numberingRules": [
    {
      "id": "num.iso19650.doc",
      "appliesTo": ["deliverable"],
      "pattern": "{PROJECT}-{ORIGINATOR}-{VOLUME}-{LEVEL}-{TYPE}-{DISCIPLINE}-{SEQ:4}",
      "separator": "-",
      "case": "upper",
      "reservable": true,
      "revisionScheme": {
        "preIssue": ["A", "B", "C", "D"],
        "postIssue": ["0", "1", "2", "3"],
        "statusCodes": ["IFR", "IFA", "IFD", "IFC", "AB"]
      }
    },
    { "id": "num.wbs", "appliesTo": ["wbsNode"], "pattern": "{PARENT}.{SEQ:2}", "separator": ".", "reservable": false },
    { "id": "num.tag", "appliesTo": ["tag"], "pattern": "{AREA}-{CLASS}-{SEQ:4}{SUFFIX}", "case": "upper" },
    { "id": "num.ncr", "appliesTo": ["ncr"], "pattern": "{PROJECT}-NCR-{DISCIPLINE}-{SEQ:4}", "case": "upper" },
    { "id": "num.tq", "appliesTo": ["tq"], "pattern": "{PROJECT}-TQ-{DISCIPLINE}-{SEQ:4}", "case": "upper" },
    { "id": "num.risk", "appliesTo": ["risk"], "pattern": "{PROJECT}-RSK-{SEQ:3}", "case": "upper" }
  ],

  "progressRules": [
    {
      "id": "roc.engineering.drawing",
      "appliesTo": ["deliverable"],
      "discipline": "*",
      "method": "ruleOfCredit",
      "steps": [
        { "code": "START", "name": { "en": "Started", "fa": "شروع شده" }, "weight": 10 },
        { "code": "IDC", "name": { "en": "Inter-discipline check complete", "fa": "کنترل بین‌دیسیپلینی انجام شد" }, "weight": 20 },
