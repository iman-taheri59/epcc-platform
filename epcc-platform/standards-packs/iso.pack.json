    { "id": "ISO-9001-02", "standardRef": "ISO 9001 cl.9.2", "requirement": { "en": "Internal audit programme executed per plan.", "fa": "برنامه ممیزی داخلی طبق برنامه اجرا شده است." }, "evidence": { "objectType": "audit", "minimumCount": 2 }, "severity": "mandatory" },
