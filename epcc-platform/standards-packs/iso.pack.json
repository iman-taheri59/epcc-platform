  "kpis": [
    { "code": "SPI", "name": { "en": "Schedule Performance Index", "fa": "شاخص عملکرد زمانی" }, "definition": { "en": "Earned value divided by planned value.", "fa": "ارزش کسب‌شده تقسیم بر ارزش برنامه‌ای." }, "formula": "sum(BCWP) / sum(BCWS)", "unit": "ratio", "target": 1.0, "direction": "higherIsBetter", "thresholds": { "green": 0.95, "amber": 0.9, "red": 0.85 }, "ownerRole": "planner", "dashboards": ["executive", "pm"] },
    { "code": "CPI", "name": { "en": "Cost Performance Index", "fa": "شاخص عملکرد هزینه" }, "definition": { "en": "Earned value divided by actual cost.", "fa": "ارزش کسب‌شده تقسیم بر هزینه واقعی." }, "formula": "sum(BCWP) / sum(ACWP)", "unit": "ratio", "target": 1.0, "direction": "higherIsBetter", "thresholds": { "green": 0.98, "amber": 0.93, "red": 0.88 }, "ownerRole": "costController", "dashboards": ["executive", "pm"] },
    { "code": "DOC_TAT", "name": { "en": "Document Turnaround Time", "fa": "زمان چرخه بازنگری مدارک" }, "definition": { "en": "Average calendar days from IFR submission to approval.", "fa": "میانگین روزهای تقویمی از ارسال IFR تا تأیید." }, "formula": "avg(days(approved_at - shared_at))", "unit": "days", "target": 14, "direction": "lowerIsBetter", "thresholds": { "green": 14, "amber": 21, "red": 30 }, "ownerRole": "documentController", "dashboards": ["engineering", "pm"] },
    { "code": "DOC_FTR", "name": { "en": "Document First-Time Approval Rate", "fa": "نرخ تأیید مدارک در نوبت اول" }, "formula": "count(deliverable where approvedAtRevision <= 1) / count(deliverable approved) * 100", "unit": "%", "target": 70, "direction": "higherIsBetter", "thresholds": { "green": 70, "amber": 55, "red": 40 }, "ownerRole": "engineeringManager", "dashboards": ["engineering"] },
    { "code": "NCR_AGE", "name": { "en": "Average Open NCR Age", "fa": "میانگین سن عدم انطباق‌های باز" }, "formula": "avg(days(now - raised_at)) where status not in terminal", "unit": "days", "target": 21, "direction": "lowerIsBetter", "thresholds": { "green": 21, "amber": 45, "red": 60 }, "ownerRole": "qaManager", "dashboards": ["quality", "pm"] },
    { "code": "FTR_QUALITY", "name": { "en": "First Time Right (Inspection)", "fa": "درستی در نوبت اول (بازرسی)" }, "formula": "count(itr where rejections == 0) / count(itr) * 100", "unit": "%", "target": 92, "direction": "higherIsBetter", "thresholds": { "green": 92, "amber": 85, "red": 75 }, "ownerRole": "qcManager", "dashboards": ["quality"] },
    { "code": "TRIR", "name": { "en": "Total Recordable Incident Rate", "fa": "نرخ کل حوادث ثبت‌شدنی" }, "formula": "count(recordableIncident) * 200000 / sum(manHours)", "unit": "ratio", "target": 0.5, "direction": "lowerIsBetter", "thresholds": { "green": 0.5, "amber": 1.0, "red": 2.0 }, "ownerRole": "hseManager", "dashboards": ["executive", "hse"] },
    { "code": "RISK_EXPOSURE", "name": { "en": "Residual Risk Exposure", "fa": "مواجهه ریسک باقیمانده" }, "formula": "sum(probability * costImpact) where status == 'open'", "unit": "currency", "direction": "lowerIsBetter", "ownerRole": "riskManager", "dashboards": ["executive", "pm"] },
    { "code": "GATE_CONFORMANCE", "name": { "en": "Gate Criteria Conformance", "fa": "انطباق معیارهای دروازه" }, "formula": "count(criterion where satisfied) / count(criterion) * 100", "unit": "%", "target": 100, "direction": "higherIsBetter", "thresholds": { "green": 100, "amber": 90, "red": 75 }, "ownerRole": "projectManager", "dashboards": ["executive"] }
