<script>\n
(function () {\n
  // WAIT FOR THE DOM.\n
  //\n
  // This partial renders the sidebar, which must come first in the document\n
  // for the flex layout - but the toggle button lives in the content column\n
  // (partials/topbar), i.e. LATER in the document. Running immediately meant\n
  // getElementById('sb-burger') returned null and the whole script bailed at\n
  // the guard below: the button rendered, looked right, and did nothing.\n
  //\n
