    transition: flex-basis .24s cubic-bezier(.4,0,.2,1),\n
                width .24s cubic-bezier(.4,0,.2,1);\n
    overflow-x: hidden;\n
  }\n
  /* Labels: inline pieces collapse horizontally... */\n
