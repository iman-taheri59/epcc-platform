    {
      "id": "SAFETY-01-unknown-check-fails-closed",
      "why": "CRITICAL. A check the engine does not implement must FAIL, never silently pass. Otherwise a pack authored for a newer engine version quietly disables its own gate on an older air-gapped install (risk IR-R4). This case was added after a mutation test proved the corpus missed it.",
      "inlinePack": {
        "releaseGates": [
          {
            "objectType": "futurePackObject",
            "hardBlock": true,
            "rules": [
              {
                "check": "asBuiltSubmitted",
                "message": {
                  "en": "As-built must be accepted.",
                  "fa": "مدارک چون‌ساخت باید پذیرفته شود."
                }
              },
              {
                "check": "someCheckFromAFutureEngineVersion",
                "message": {
                  "en": "Not implemented here.",
                  "fa": "در این نسخه پیاده‌سازی نشده."
                }
              }
            ],
            "waiver": {
              "allowed": false
            }
          }
        ]
      },
      "objectType": "futurePackObject",
      "facts": {
        "asBuilt": {
          "status": "ACCEPTED"
        }
      },
      "expect": {
        "passed": false,
        "blocked": true,
        "waiverAllowed": false,
        "absolutelyBlocked": true,
        "failedChecks": [
          "someCheckFromAFutureEngineVersion"
        ],
        "requireBilingualMessages": true
      }
    },
    {
      "id": "SAFETY-02-unknown-check-with-argument",
      "why": "Same fail-closed rule when the unknown check carries an argument.",
      "inlinePack": {
