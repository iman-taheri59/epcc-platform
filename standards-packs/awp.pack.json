  "complianceChecklist": [
    { "id": "AWP-01", "standardRef": "CII RT-272 P1", "requirement": { "en": "Path of Construction is defined and approved before detailed engineering begins.", "fa": "مسیر اجرا پیش از آغاز مهندسی تفصیلی تعریف و تأیید شده است." }, "evidence": { "objectType": "pathOfConstruction", "condition": "approved == true" }, "severity": "mandatory" },
    { "id": "AWP-02", "standardRef": "CII RT-272 P2", "requirement": { "en": "Every EWP is aligned to at least one CWP.", "fa": "هر بسته کاری مهندسی به حداقل یک بسته کاری اجرا متصل است." }, "evidence": { "objectType": "ewp", "condition": "cwp_id != null" }, "severity": "mandatory" },
    { "id": "AWP-03", "standardRef": "COAA WFP", "requirement": { "en": "IWPs are sized between 5 and 10 crew-days.", "fa": "حجم بسته‌های نصب بین ۵ تا ۱۰ نفر-روز اکیپ است." }, "evidence": { "objectType": "iwp", "condition": "crewDays >= 5 and crewDays <= 10" }, "severity": "mandatory" },
    { "id": "AWP-04", "standardRef": "COAA WFP", "requirement": { "en": "No IWP is released with open hard constraints unless a waiver is approved and justified.", "fa": "هیچ بسته نصبی با قید سخت باز صادر نمی‌شود مگر با معافیت تأییدشده و مستدل." }, "evidence": { "objectType": "iwp", "condition": "state >= 'ISSUED' implies openHardConstraints == 0 or waiverApproved == true" }, "severity": "mandatory" },
    { "id": "AWP-05", "standardRef": "COAA WFP", "requirement": { "en": "A rolling constraint-free backlog of at least 3 weeks is maintained.", "fa": "ذخیره بسته‌های بدون قید حداقل به میزان ۳ هفته حفظ می‌شود." }, "evidence": { "objectType": "kpi", "condition": "IWP_BACKLOG_WEEKS >= 3" }, "severity": "recommended" },
    { "id": "AWP-06", "standardRef": "CII RT-319", "requirement": { "en": "AWP roles are formally appointed and staffed on the project.", "fa": "نقش‌های AWP رسماً منصوب و تأمین نیرو شده‌اند." }, "evidence": { "objectType": "projectRole", "condition": "role in ['awpChampion','wfpCoordinator'] and assigned == true" }, "severity": "mandatory" },
    { "id": "AWP-07", "standardRef": "CII RT-272 P3", "requirement": { "en": "Turnover work packages are mapped to systems and subsystems from the start.", "fa": "بسته‌های کاری تحویل از ابتدا به سیستم‌ها و زیرسیستم‌ها نگاشت شده‌اند." }, "evidence": { "objectType": "twp", "condition": "system_id != null" }, "severity": "recommended" },
    { "id": "AWP-08", "standardRef": "COAA WFP", "requirement": { "en": "Tool time studies are conducted at least quarterly.", "fa": "مطالعات زمان مفید ابزار حداقل فصلی انجام می‌شود." }, "evidence": { "objectType": "toolTimeStudy", "minimumCount": 1 }, "severity": "recommended" }
  ],

  "settings": {
    "iwpTargetCrewDays": 10,
    "iwpMinCrewDays": 5,
    "hardBlockOnConstraint": true,
    "constraintPromiseDateRequired": true,
    "lookaheadHorizons": [90, 60, 30, 6],
    "backlogTargetWeeks": 4,
    "materialReservationRequired": true,
    "modelBasedScoping": true,
    "defaultCalendar": "gregorian",
    "secondaryCalendar": "jalali",
    "workingWeek": ["saturday", "sunday", "monday", "tuesday", "wednesday"],
    "punchCategories": ["A", "B", "C"],
    "itrTypes": ["A", "B", "C"]
  }
