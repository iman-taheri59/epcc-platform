{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Basic allowable stresses in tension (ASME B31.3 Table A-1)",
 "type": "object",
 "required": ["refId","version","source","units","standard","basisClause","materials"],
 "additionalProperties": false,
 "properties": {
  "refId": {"const": "allowable-stress"},
  "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "source": {"type": "string", "minLength": 20},
  "note": {"type": "string"},
  "conventions": {"type": "object"},
  "units": {"type": "object", "required": ["stress","temperature"], "additionalProperties": false,
            "properties": {"stress": {"const": "MPa"}, "temperature": {"const": "C"}}},
  "standard": {"type": "object", "required": ["code","editionYear","sourceTable"],
               "additionalProperties": false,
               "properties": {"code": {"const": "B31.3"}, "editionYear": {"type": "integer"},
                              "title": {"type": "string"}, "sourceTable": {"type": "string"}}},
  "basisClause": {"type": "object", "required": ["clause","formula","toleranceFraction"],
                  "additionalProperties": true},
  "materials": {
   "type": "array", "minItems": 1,
   "items": {"type": "object",
     "required": ["spec","grade","uns","descriptionAsWritten","sectionIndex","lineNo",
                  "points","verified","source","readOn","heldNotCitableBecause","basisCheck"],
     "additionalProperties": false,
     "properties": {
       "spec": {"type": "string", "pattern": "^[AB][0-9]{2,4}[A-Z]?$"},
       "grade": {"type": ["string","null"]},
       "uns": {"type": ["string","null"]},
       "descriptionAsWritten": {"type": "string"},
       "sectionIndex": {"type": "integer", "minimum": 0},
       "lineNo": {"type": "integer", "minimum": 1},
       "verified": {"type": "boolean"},
       "source": {"type": ["string","null"]},
       "readOn": {"type": ["string","null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
       "heldNotCitableBecause": {"type": ["string","null"], "minLength": 30},
       "basisCheck": {"type": ["object","null"]},
       "points": {"type": "array", "minItems": 1,
         "items": {"type": "object", "required": ["temperatureC","stressMpa"],
           "additionalProperties": false,
           "properties": {"temperatureC": {"type": "integer"},
                          "stressMpa": {"type": "number", "exclusiveMinimum": 0}}}}}}}
 }
}
