{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component templates reference pack",
  "type": "object",
  "required": ["refId", "version", "source", "portRoles", "sizeRules", "templates"],
  "additionalProperties": false,
  "properties": {
    "refId": {"const": "component-templates"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"type": "string", "minLength": 10},
    "note": {"type": "string"},
    "portRoles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/i18n"}},
    "sizeRules": {"type": "object", "additionalProperties": {"type": "string"}},
    "templates": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["code", "name", "category", "sizeRule", "ports"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "name": {"$ref": "#/$defs/i18n"},
          "category": {"enum": ["PIPE", "FITTING", "FLANGE", "VALVE", "INSTRUMENT", "SUPPORT", "EQUIPMENT"]},
          "sizeRule": {"enum": ["SAME_AS_FIRST", "INDEPENDENT", "BRANCH_LE_RUN", "LARGE_GT_SMALL"]},
          "qualifiers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "qualifierDerived": {"type": "boolean"},
          "hasLength": {"type": "boolean"},
          "requiresRating": {"type": "boolean"},
          "requiresFacing": {"type": "boolean"},
          "isTagged": {"type": "boolean"},
          "directional": {"type": "boolean"},
          "instrument": {"type": "boolean"},
          "terminates": {"type": "boolean"},
          "ownerKind": {"enum": ["COMPONENT", "NOZZLE"]},
          "note": {"$ref": "#/$defs/i18n"},
          "ports": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["seq", "role", "defaultEnd"],
              "additionalProperties": false,
              "properties": {
                "seq": {"type": "integer", "minimum": 1},
                "role": {"enum": ["RUN", "BRANCH", "INLET", "OUTLET", "LARGE", "SMALL", "NOZZLE"]},
                "defaultEnd": {"type": "string", "minLength": 2, "maxLength": 2},
                "attachesToBody": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "required": ["en", "fa"],
      "additionalProperties": false,
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "fa": {"type": "string", "minLength": 1}
      }
    }
  }
}
