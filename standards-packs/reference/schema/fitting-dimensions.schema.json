{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Buttwelding fitting dimensions (ASME B16.9)",
 "type": "object",
 "required": [
  "refId",
  "version",
  "source",
  "units",
  "standard",
  "verified",
  "readOn",
  "dimensions",
  "sizeRange"
 ],
 "additionalProperties": false,
 "properties": {
  "refId": {
   "const": "fitting-dimensions"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "source": {
   "type": "string",
   "minLength": 20
  },
  "note": {
   "type": "string"
  },
  "conventions": {
   "type": "object"
  },
  "units": {
   "type": "object",
   "required": [
    "length"
   ],
   "additionalProperties": false,
   "properties": {
    "length": {
     "const": "mm"
    }
   }
  },
  "standard": {
   "type": "object",
   "required": [
    "code",
    "editionYear",
    "sourceTables"
   ],
   "additionalProperties": false,
   "properties": {
    "code": {
     "const": "B16.9"
    },
    "editionYear": {
     "type": "integer"
    },
    "title": {
     "type": "string"
    },
    "sourceTables": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "verified": {
   "type": "boolean"
  },
  "readOn": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "dimensions": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "fitting",
     "qualifier",
     "nps",
     "dn",
     "odMm",
     "dimension",
     "symbol",
     "mm",
     "sourceTable"
    ],
    "additionalProperties": false,
    "properties": {
     "fitting": {
      "enum": [
       "ELBOW",
       "CAP"
      ]
     },
     "qualifier": {
      "type": [
       "string",
       "null"
      ]
     },
     "nps": {
      "type": "string"
     },
     "dn": {
      "type": "integer",
      "minimum": 1
     },
     "odMm": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "dimension": {
      "enum": [
       "CENTRE_TO_END",
       "LENGTH"
      ]
     },
     "symbol": {
      "type": "string"
     },
     "mm": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "sourceTable": {
      "type": "string"
     },
     "limitingWallThicknessMm": {
      "type": [
       "number",
       "null"
      ],
      "exclusiveMinimum": 0
     },
     "e1Mm": {
      "type": [
       "number",
       "null"
      ],
      "exclusiveMinimum": 0
     },
     "requiresManufacturerAgreement": {
      "type": "boolean"
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "fitting": {
         "const": "CAP"
        }
       },
       "required": [
        "fitting"
       ]
      },
      "then": {
       "required": [
        "limitingWallThicknessMm",
        "e1Mm",
        "requiresManufacturerAgreement"
       ],
       "allOf": [
        {
         "if": {
          "properties": {
           "dn": {
            "maximum": 600
           }
          }
         },
         "then": {
          "properties": {
           "limitingWallThicknessMm": {
            "type": "number"
           },
           "e1Mm": {
            "type": "number"
           },
           "requiresManufacturerAgreement": {
            "const": false
           }
          }
         },
         "else": {
          "properties": {
           "limitingWallThicknessMm": {
            "type": "null"
           },
           "e1Mm": {
            "type": "null"
           },
           "requiresManufacturerAgreement": {
            "const": true
           }
          }
         }
        }
       ]
      },
      "else": {
       "not": {
        "anyOf": [
         {
          "required": [
           "limitingWallThicknessMm"
          ]
         },
         {
          "required": [
           "e1Mm"
          ]
         },
         {
          "required": [
           "requiresManufacturerAgreement"
          ]
         }
        ]
       }
      }
     }
    ]
   }
  },
  "notBuiltYet": {
   "type": "object"
  },
  "sizeRange": {
   "type": "object",
   "required": [
    "minNps",
    "maxNps",
    "sourceClause",
    "outsideRangePolicy"
   ],
   "additionalProperties": false,
   "properties": {
    "minNps": {
     "const": 0.5
    },
    "maxNps": {
     "const": 48
    },
    "sourceClause": {
     "const": "1.1 General"
    },
    "outsideRangePolicy": {
     "const": "PROJECT_SPEC_REQUIRED"
    }
   }
  }
 }
}
