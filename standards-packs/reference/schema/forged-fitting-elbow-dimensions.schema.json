{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASME B16.11 forged fitting elbow dimensions (SI)",
  "type": "object",
  "required": [
    "refId",
    "version",
    "source",
    "units",
    "standard",
    "verified",
    "readOn",
    "notes",
    "coverage",
    "dimensions"
  ],
  "additionalProperties": false,
  "properties": {
    "refId": {"const": "forged-fitting-elbow-dimensions"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"type": "string", "minLength": 40},
    "units": {
      "type": "object",
      "required": ["length", "system"],
      "additionalProperties": false,
      "properties": {
        "length": {"const": "mm"},
        "system": {"const": "SI"}
      }
    },
    "standard": {
      "type": "object",
      "required": ["code", "editionYear", "title", "sourceTables", "sourceFigures", "sourcePdfSha256"],
      "additionalProperties": false,
      "properties": {
        "code": {"const": "B16.11"},
        "editionYear": {"const": 2021},
        "title": {"type": "string"},
        "sourceTables": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["Table 1.1.1-1", "Table 6.1-1", "Table 6.1-3"]}
        },
        "sourceFigures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"const": "Figure 6.2.7-1"}
        },
        "sourcePdfSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "verified": {"type": "boolean"},
    "readOn": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "notes": {
      "type": "object",
      "required": [
        "coverage",
        "socketWeldDimensions",
        "threadedDimensions",
        "qualifierSemantics",
        "classDesignation",
        "scope",
        "unitBasis",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "coverage": {"type": "string", "minLength": 20},
        "socketWeldDimensions": {"type": "string", "minLength": 20},
        "threadedDimensions": {"type": "string", "minLength": 20},
        "qualifierSemantics": {"type": "string", "minLength": 20},
        "classDesignation": {"type": "string", "minLength": 20},
        "scope": {"type": "string", "minLength": 20},
        "unitBasis": {"type": "string", "minLength": 20},
        "limitations": {"type": "string", "minLength": 20}
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["endConfiguration", "classDesignation", "nps"],
        "additionalProperties": false,
        "properties": {
          "endConfiguration": {"enum": ["SOCKET_WELD_BOTH_ENDS", "THREADED_BOTH_ENDS"]},
          "classDesignation": {"enum": [2000, 3000, 6000, 9000]},
          "nps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["1/8", "1/4", "3/8", "1/2", "3/4", "1", "1 1/4", "1 1/2", "2", "2 1/2", "3", "4"]}
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 63,
      "maxItems": 63,
      "items": {
        "type": "object",
        "required": ["endConfiguration", "classDesignation", "nps", "bendDimensions", "sourceTable"],
        "additionalProperties": false,
        "properties": {
          "endConfiguration": {"enum": ["SOCKET_WELD_BOTH_ENDS", "THREADED_BOTH_ENDS"]},
          "classDesignation": {"enum": [2000, 3000, 6000, 9000]},
          "nps": {"enum": ["1/8", "1/4", "3/8", "1/2", "3/4", "1", "1 1/4", "1 1/2", "2", "2 1/2", "3", "4"]},
          "socketDepthMinMm": {"type": "number", "exclusiveMinimum": 0},
          "bendDimensions": {"type": "object"},
          "sourceTable": {"enum": ["Table 6.1-1", "Table 6.1-3"]}
        },
        "oneOf": [
          {
            "properties": {
              "endConfiguration": {"const": "SOCKET_WELD_BOTH_ENDS"},
              "classDesignation": {"enum": [3000, 6000, 9000]},
              "socketDepthMinMm": {"type": "number", "exclusiveMinimum": 0},
              "bendDimensions": {
                "type": "object",
                "required": ["90", "45"],
                "additionalProperties": false,
                "properties": {
                  "90": {"$ref": "#/$defs/socketCenterToBottom"},
                  "45": {"$ref": "#/$defs/socketCenterToBottom"}
                }
              },
              "sourceTable": {"const": "Table 6.1-1"}
            },
            "required": ["socketDepthMinMm"]
          },
          {
            "properties": {
              "endConfiguration": {"const": "THREADED_BOTH_ENDS"},
              "classDesignation": {"enum": [2000, 3000, 6000]},
              "bendDimensions": {
                "type": "object",
                "required": ["90", "45"],
                "additionalProperties": false,
                "properties": {
                  "90": {"$ref": "#/$defs/threadedCenterToEndA"},
                  "45": {"$ref": "#/$defs/threadedCenterToEndC"}
                }
              },
              "sourceTable": {"const": "Table 6.1-3"}
            },
            "not": {"required": ["socketDepthMinMm"]}
          }
        ]
      }
    }
  },
  "$defs": {
    "dimensionValue": {
      "type": "object",
      "required": ["dimension", "symbol", "mm"],
      "additionalProperties": false,
      "properties": {
        "dimension": {"type": "string"},
        "symbol": {"type": "string"},
        "mm": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "socketCenterToBottom": {
      "allOf": [
        {"$ref": "#/$defs/dimensionValue"},
        {"properties": {"dimension": {"const": "CENTRE_TO_BOTTOM_OF_SOCKET"}, "symbol": {"const": "A"}}}
      ]
    },
    "threadedCenterToEndA": {
      "allOf": [
        {"$ref": "#/$defs/dimensionValue"},
        {"properties": {"dimension": {"const": "CENTRE_TO_END"}, "symbol": {"const": "A"}}}
      ]
    },
    "threadedCenterToEndC": {
      "allOf": [
        {"$ref": "#/$defs/dimensionValue"},
        {"properties": {"dimension": {"const": "CENTRE_TO_END"}, "symbol": {"const": "C"}}}
      ]
    }
  }
}
