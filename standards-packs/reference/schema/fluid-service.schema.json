{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Fluid service and examination extent (ASME B31.3)",
 "type": "object",
 "required": [
  "refId",
  "version",
  "source",
  "units",
  "standard",
  "fluidServices",
  "conditions",
  "examinationExtent"
 ],
 "additionalProperties": false,
 "properties": {
  "refId": {
   "const": "fluid-service"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "source": {
   "type": "string",
   "minLength": 20
  },
  "note": {
   "type": "string"
  },
  "conventions": {
   "type": "object"
  },
  "units": {
   "type": "object",
   "required": [
    "pressure",
    "temperature"
   ],
   "additionalProperties": false,
   "properties": {
    "pressure": {
     "const": "kPa"
    },
    "temperature": {
     "const": "C"
    }
   }
  },
  "standard": {
   "type": "object",
   "required": [
    "code",
    "editionYear",
    "sourceClauses"
   ],
   "additionalProperties": false,
   "properties": {
    "code": {
     "const": "B31.3"
    },
    "editionYear": {
     "type": "integer"
    },
    "title": {
     "type": "string"
    },
    "sourceClauses": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "fluidServices": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "code",
     "clause",
     "isCondition",
     "name",
     "definitionIsTestable",
     "definition",
     "bounds"
    ],
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string",
      "pattern": "^[A-Z_]+$"
     },
     "clause": {
      "type": "string"
     },
     "isCondition": {
      "const": false
     },
     "name": {
      "type": "object",
      "required": [
       "en",
       "fa"
      ],
      "additionalProperties": false,
      "properties": {
       "en": {
        "type": "string"
       },
       "fa": {
        "type": "string"
       }
      }
     },
     "definitionIsTestable": {
      "type": "boolean"
     },
     "definition": {
      "type": "string",
      "minLength": 40
     },
     "bounds": {
      "type": [
       "object",
       "null"
      ]
     }
    }
   }
  },
  "conditions": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "code",
     "clause",
     "isCondition",
     "name",
     "definition",
     "appliesAlongsideAnyFluidService",
     "note"
    ],
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "clause": {
      "type": "string"
     },
     "isCondition": {
      "const": true
     },
     "name": {
      "type": "object"
     },
     "definition": {
      "type": "string",
      "minLength": 40
     },
     "appliesAlongsideAnyFluidService": {
      "type": "boolean"
     },
     "note": {
      "type": "string",
      "minLength": 40
     }
    }
   }
  },
  "examinationExtent": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "appliesTo",
     "clause",
     "verified",
     "source",
     "readOn",
     "requirements"
    ],
    "additionalProperties": false,
    "properties": {
     "appliesTo": {
      "type": "string"
     },
     "clause": {
      "type": "string"
     },
     "isCondition": {
      "type": "boolean"
     },
     "verified": {
      "type": "boolean"
     },
     "source": {
      "type": "string"
     },
     "readOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object"
      }
     }
    }
   }
  },
  "notBuiltInThisSlice": {
   "type": "object"
  },
  "wallThickness": {
   "type": "object",
   "required": [
    "clause",
    "verified",
    "source",
    "readOn",
    "equation3a",
    "equation3b",
    "minimumRequired",
    "symbols",
    "validity"
   ],
   "additionalProperties": false,
   "properties": {
    "clause": {
     "type": "string"
    },
    "verified": {
     "type": "boolean"
    },
    "source": {
     "type": "string"
    },
    "readOn": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "equation3a": {
     "type": "string"
    },
    "equation3b": {
     "type": "string"
    },
    "minimumRequired": {
     "type": "string"
    },
    "symbols": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "validity": {
     "type": "object"
    }
   }
  },
  "coefficientY": {
   "type": "object",
   "required": [
    "table",
    "verified",
    "source",
    "readOn",
    "temperaturesC",
    "rows",
    "firstColumnIsAndBelow",
    "lastColumnIsAndAbove"
   ],
   "additionalProperties": false,
   "properties": {
    "table": {
     "type": "string"
    },
    "verified": {
     "type": "boolean"
    },
    "source": {
     "type": "string"
    },
    "readOn": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "firstColumnIsAndBelow": {
     "type": "boolean"
    },
    "lastColumnIsAndAbove": {
     "type": "boolean"
    },
    "temperaturesC": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "rows": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "material",
       "values"
      ],
      "additionalProperties": false,
      "properties": {
       "material": {
        "type": "string"
       },
       "values": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "appliesToUns": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "note": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "tableA1ProductForms": {
   "type": "object"
  }
 }
}
