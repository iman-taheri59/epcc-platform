{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Flange pressure-temperature ratings reference pack",
 "type": "object",
 "required": [
  "refId",
  "version",
  "source",
  "note",
  "units",
  "conventions",
  "standards",
  "derivedClasses",
  "curves",
  "corroboration"
 ],
 "additionalProperties": false,
 "properties": {
  "refId": {
   "const": "flange-pt-ratings"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "source": {
   "type": "string",
   "minLength": 20
  },
  "note": {
   "type": "string",
   "minLength": 20
  },
  "units": {
   "type": "object",
   "required": [
    "pressure",
    "temperature"
   ],
   "additionalProperties": false,
   "properties": {
    "pressure": {
     "const": "kPa",
     "description": "The project's canonical pressure unit. bar and psi are presentation only."
    },
    "temperature": {
     "const": "C"
    }
   }
  },
  "conventions": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "string",
    "minLength": 20
   }
  },
  "standards": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "code",
     "editionYear",
     "npsFrom",
     "npsTo",
     "classes"
    ],
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string",
      "minLength": 3
     },
     "editionYear": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
     },
     "npsFrom": {
      "type": "string",
      "minLength": 1
     },
     "npsTo": {
      "type": "string",
      "minLength": 1
     },
     "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^[0-9]+$"
      }
     },
     "seriesShareRatings": {
      "type": "boolean",
      "description": "True where dimensional series of the same standard share one rating table, as B16.47 A and B do."
     },
     "note": {
      "type": "string",
      "minLength": 10
     },
     "classesBySeries": {
      "type": "object",
      "description": "Classes available per dimensional series. B16.47 Class 75 is Series B only."
     }
    }
   }
  },
  "derivedClasses": {
   "type": "array",
   "description": "Classes that no standard tabulates and that are computed from ones that are - API 602's Class 800.",
   "items": {
    "type": "object",
    "required": [
     "class",
     "definedBy",
     "appliesToStandard",
     "derivedFrom",
     "verified",
     "note"
    ],
    "additionalProperties": false,
    "properties": {
     "class": {
      "type": "string",
      "pattern": "^[0-9]+$"
     },
     "definedBy": {
      "type": "string",
      "minLength": 3
     },
     "appliesToStandard": {
      "type": "string",
      "minLength": 3
     },
     "derivedFrom": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "required": [
        "class",
        "weight"
       ],
       "additionalProperties": false,
       "properties": {
        "class": {
         "type": "string",
         "pattern": "^[0-9]+$"
        },
        "weight": {
         "type": "number",
         "exclusiveMinimum": 0,
         "maximum": 1
        }
       }
      }
     },
     "verified": {
      "type": "boolean"
     },
     "note": {
      "type": "string",
      "minLength": 20
     },
     "definedByClause": {
      "type": "string",
      "minLength": 10
     },
     "readOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "correctedFromGuess": {
      "type": "object"
     },
     "corroboration": {
      "type": "object"
     },
     "undatedReference": {
      "type": "string",
      "minLength": 40
     }
    }
   }
  },
  "curves": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "standard",
     "editionYear",
     "materialGroup",
     "verified",
     "materials",
     "points"
    ],
    "additionalProperties": false,
    "properties": {
     "standard": {
      "type": "string",
      "minLength": 3
     },
     "editionYear": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
     },
     "materialGroup": {
      "type": "string",
      "pattern": "^[123]\\.[0-9]{1,2}$",
      "description": "The B16.5 material group, matching materials.ref.json's b165MaterialGroup."
     },
     "verified": {
      "type": "boolean"
     },
     "materials": {
      "type": "string"
     },
     "points": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "required": [
        "temperatureC",
        "byClass"
       ],
       "additionalProperties": false,
       "properties": {
        "temperatureC": {
         "type": "number",
         "minimum": -273
        },
        "byClass": {
         "type": "object",
         "minProperties": 1,
         "propertyNames": {
          "pattern": "^[0-9]+$"
         },
         "additionalProperties": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum allowable working gauge pressure, kPa."
         }
        }
       }
      }
     },
     "sourceTable": {
      "type": "string",
      "minLength": 3,
      "description": "The numbered table actually read, e.g. 'Table 2-1.1'. Present only on verified curves."
     }
    }
   }
  },
  "corroboration": {
   "type": "object",
   "description": "Evidence gathered AFTER the numbers were written. It can only fail to disprove them, never make them citable. Recorded so the next reader knows exactly how much weight the figures carry.",
   "required": [
    "whatThisIsNot",
    "internalChecks",
    "externalSpotChecks"
   ],
   "additionalProperties": false,
   "properties": {
    "whatThisIsNot": {
     "type": "string"
    },
    "internalChecks": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "check",
       "result",
       "passed"
      ],
      "additionalProperties": false,
      "properties": {
       "check": {
        "type": "string",
        "minLength": 20
       },
       "result": {
        "type": "string",
        "minLength": 5
       },
       "passed": {
        "type": "boolean"
       }
      }
     }
    },
    "externalSpotChecks": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "source",
       "claim",
       "deviation"
      ],
      "additionalProperties": false,
      "properties": {
       "source": {
        "type": "string",
        "minLength": 5
       },
       "claim": {
        "type": "string",
        "minLength": 5
       },
       "deviation": {
        "type": "string",
        "minLength": 2
       },
       "note": {
        "type": "string",
        "minLength": 10
       }
      }
     }
    },
    "priorReconstruction": {
     "type": "object"
    }
   }
  },
  "crossStandardDiscrepancies": {
   "type": "object",
   "description": "Cells where two purchased standards disagree. Neither transcription is altered."
  }
 }
}
