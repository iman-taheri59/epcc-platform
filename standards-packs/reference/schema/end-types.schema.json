{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "End types reference pack",
  "type": "object",
  "required": ["refId", "version", "source", "endTypes"],
  "additionalProperties": false,
  "properties": {
    "refId": {"const": "end-types"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"type": "string", "minLength": 10},
    "note": {"type": "string"},
    "endTypes": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["code", "name", "weldable", "numbered", "genderRequired"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "minLength": 2, "maxLength": 2},
          "name": {"$ref": "#/$defs/i18n"},
          "weldable": {"type": "boolean"},
          "numbered": {"type": "boolean"},
          "genderRequired": {"type": "boolean"},
          "wildcard": {"type": "boolean"},
          "note": {"$ref": "#/$defs/i18n"}
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "required": ["en", "fa"],
      "additionalProperties": false,
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "fa": {"type": "string", "minLength": 1}
      }
    }
  }
}
