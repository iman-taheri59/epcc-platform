{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Valve inspection and testing reference pack (API 598)",
 "type": "object",
 "required": ["refId", "version", "source", "units", "standard", "columns",
              "requirements", "shellTestPressure", "shellTestRule",
              "closureTestPressure", "duration", "leakage"],
 "additionalProperties": false,
 "properties": {
  "refId": {"const": "valve-testing"},
  "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "source": {"type": "string", "minLength": 10},
  "note": {"type": "string"},
  "conventions": {"type": "object"},
  "units": {
   "type": "object",
   "required": ["pressure", "alternatePressure", "duration"],
   "additionalProperties": false,
   "properties": {
    "pressure": {"const": "barG"},
    "alternatePressure": {"const": "psig"},
    "duration": {"const": "seconds"}
   }
  },
  "standard": {
   "type": "object",
   "required": ["code", "editionYear", "tests", "sourceTables"],
   "additionalProperties": false,
   "properties": {
    "code": {"const": "API 598"},
    "editionYear": {"type": "integer", "minimum": 1900},
    "edition": {"type": "string"},
    "title": {"type": "string"},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sourceTables": {"type": "array", "minItems": 1, "items": {"type": "string"}}
   }
  },
  "columns": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["valveType", "variant"],
    "additionalProperties": false,
    "properties": {
     "valveType": {"type": "string"},
     "variant": {"type": ["string", "null"]},
     "alsoCovers": {
      "type": "array",
      "items": {
       "type": "object",
       "required": ["valveType", "variant"],
       "additionalProperties": false,
       "properties": {
        "valveType": {"type": "string"},
        "variant": {"type": ["string", "null"]}
       }
      }
     }
    }
   }
  },
  "requirements": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["test", "column", "sizeBand", "classBand", "requirement", "noteRefs"],
    "additionalProperties": false,
    "properties": {
     "test": {"enum": ["SHELL", "BACKSEAT", "LOW_PRESSURE_CLOSURE",
                       "HIGH_PRESSURE_CLOSURE"]},
     "column": {"type": "string"},
     "sizeBand": {
      "type": "object",
      "required": ["maxDn", "minDnExclusive", "label"],
      "additionalProperties": false,
      "properties": {
       "maxDn": {"type": ["integer", "null"]},
       "minDnExclusive": {"type": ["integer", "null"]},
       "label": {"type": "string"}
      }
     },
     "classBand": {
      "type": "object",
      "required": ["maxClass", "minClassExclusive", "label"],
      "additionalProperties": false,
      "properties": {
       "maxClass": {"type": ["integer", "null"]},
       "minClassExclusive": {"type": ["integer", "null"]},
       "label": {"type": "string"}
      }
     },
     "requirement": {"enum": ["REQUIRED", "OPTIONAL", "NOT_APPLICABLE"]},
     "noteRefs": {"type": "array", "items": {"type": "string"}}
    }
   }
  },
  "requirementNotes": {"type": "object", "additionalProperties": {"type": "string"}},
  "shellTestPressure": {"type": "array", "minItems": 1, "items": {"type": "object"}},
  "shellTestRule": {
   "type": "object",
   "required": ["code", "multiplier", "ratingTemperatureC", "roundTo", "text"],
   "additionalProperties": true
  },
  "closureTestPressure": {"type": "array", "minItems": 1, "items": {"type": "object"}},
  "closureTestRules": {"type": "object"},
  "duration": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["dnFrom", "dnTo", "npsLabel", "shell", "backseat",
                 "closureCheck", "closureOther"],
    "additionalProperties": false,
    "properties": {
     "dnFrom": {"type": ["integer", "null"]},
     "dnTo": {"type": ["integer", "null"]},
     "npsLabel": {"type": "string"},
     "shell": {"type": "integer", "minimum": 1},
     "backseat": {"type": "integer", "minimum": 1},
     "closureCheck": {"type": "integer", "minimum": 1},
     "closureOther": {"type": "integer", "minimum": 1}
    }
   }
  },
  "leakage": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["dn", "nps", "resilientSeated", "metalLiquidDropsPerMin",
                 "metalLiquidMlPerMin", "metalGasBubblesPerMin", "metalGasMlPerMin",
                 "checkLiquidMlPerMin", "checkGasM3PerH", "checkGasFt3PerH",
                 "noteRefs"],
    "additionalProperties": false,
    "properties": {
     "dn": {"type": "integer", "minimum": 1},
     "nps": {"type": "string"},
     "resilientSeated": {"type": "number", "minimum": 0},
     "metalLiquidDropsPerMin": {"type": "number", "minimum": 0},
     "metalLiquidMlPerMin": {"type": "number", "minimum": 0},
     "metalGasBubblesPerMin": {"type": "number", "minimum": 0},
     "metalGasMlPerMin": {"type": "number", "minimum": 0},
     "checkLiquidMlPerMin": {"type": "number", "minimum": 0},
     "checkGasM3PerH": {"type": "number", "minimum": 0},
     "checkGasFt3PerH": {"type": "number", "minimum": 0},
     "noteRefs": {"type": "array", "items": {"type": "string"}}
    }
   }
  },
  "leakageFormulasAboveTable": {"type": "object"},
  "pneumaticShellTest": {"type": "object"}
 }
}
