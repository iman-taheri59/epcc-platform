{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Valve construction standard reference pack",
 "type": "object",
 "required": [
  "refId",
  "version",
  "source",
  "standards"
 ],
 "additionalProperties": false,
 "properties": {
  "refId": {
   "const": "valve-construction"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "source": {
   "type": "string",
   "minLength": 10
  },
  "note": {
   "type": "string"
  },
  "conventions": {
   "type": "object"
  },
  "standards": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "title",
     "npsMin",
     "bodyGroups",
     "verified",
     "sourceQuality",
     "code",
     "npsMax",
     "valveTypes"
    ],
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9 ]*[0-9][A-Z]?$"
     },
     "title": {
      "type": "object",
      "required": [
       "en",
       "fa"
      ],
      "additionalProperties": false,
      "properties": {
       "en": {
        "type": "string",
        "minLength": 1
       },
       "fa": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "valveTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "pattern": "^[A-Z][A-Z0-9_]*$"
      }
     },
     "bodyGroups": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "string"
      }
     },
     "npsMin": {
      "type": [
       "number",
       "null"
      ],
      "exclusiveMinimum": 0
     },
     "npsMax": {
      "type": [
       "number",
       "null"
      ],
      "exclusiveMinimum": 0
     },
     "note": {
      "type": "object",
      "required": [
       "en",
       "fa"
      ],
      "additionalProperties": false,
      "properties": {
       "en": {
        "type": "string",
        "minLength": 1
       },
       "fa": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "verified": {
      "type": "boolean"
     },
     "editionYear": {
      "type": "integer",
      "minimum": 1900
     },
     "pressureClasses": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[0-9]+$"
      }
     },
     "designFeatures": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "endTypes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "sourceQuality": {
      "enum": [
       "NOT_HELD",
       "TEXT",
       "SCANNED_IMAGE"
      ]
     },
     "verifiedFrom": {
      "type": "string",
      "minLength": 10
     },
     "correctedFromGuess": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "required": [
        "was",
        "now",
        "evidence"
       ],
       "additionalProperties": false,
       "properties": {
        "was": {},
        "now": {},
        "evidence": {
         "type": "string",
         "minLength": 40
        }
       }
      }
     },
     "tablesNotTranscribed": {
      "type": "object",
      "required": [
       "tables",
       "reason",
       "whatWouldFixIt"
      ],
      "additionalProperties": false,
      "properties": {
       "tables": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "reason": {
        "type": "string",
        "minLength": 40
       },
       "whatWouldFixIt": {
        "type": "string",
        "minLength": 10
       }
      }
     },
     "bodyMaterialGroups": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[0-9]+$"
      }
     },
     "bodyMaterialGroupsNote": {
      "type": "object"
     },
     "testedTo": {
      "type": [
       "string",
       "null"
      ],
      "minLength": 3
     },
     "trimVocabulary": {
      "type": "object"
     },
     "endTypeScopes": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "endType",
        "npsMin",
        "npsMax",
        "pressureClasses"
       ],
       "additionalProperties": false,
       "properties": {
        "endType": {
         "type": "string"
        },
        "npsMin": {
         "type": "number"
        },
        "npsMax": {
         "type": "number"
        },
        "pressureClasses": {
         "type": "array",
         "items": {
          "type": "string"
         }
        }
       }
      }
     },
     "designVariants": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "string"
      }
     },
     "designVariantsNote": {
      "type": "object"
     },
     "boreSizes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "ratingRule": {
      "type": "string",
      "minLength": 40
     },
     "variantScopes": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "bodyGroupsNote": {
      "type": "object"
     },
     "npsMaxBeyondPipeSizes": {
      "type": "object",
      "required": [
       "value",
       "note"
      ],
      "additionalProperties": false,
      "properties": {
       "value": {
        "type": "boolean"
       },
       "note": {
        "type": "string",
        "minLength": 40
       }
      }
     },
     "pressureClassSources": {
      "type": "object"
     },
     "excludes": {
      "type": "string",
      "minLength": 20
     },
     "patterns": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "patternsNote": {
      "type": "object"
     },
     "trimNumberSystem": {
      "type": "boolean"
     },
     "edition": {
      "type": "string"
     },
     "documentKind": {
      "enum": [
       "STANDARD",
       "SPECIFICATION"
      ]
     },
     "coversService": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "classesExplicitlyRemoved": {
      "type": "object"
     },
     "faceToFaceSource": {
      "type": "string"
     },
     "faceToFaceNote": {
      "type": "object"
     },
     "valveTypesBeyondTemplate": {
      "type": "object",
      "required": [
       "types",
       "note"
      ],
      "additionalProperties": false,
      "properties": {
       "types": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "note": {
        "type": "string",
        "minLength": 60
       }
      }
     },
     "pnDesignations": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[0-9]+$"
      }
     },
     "pnDesignationsNote": {
      "type": "object"
     }
    }
   }
  }
 }
}
